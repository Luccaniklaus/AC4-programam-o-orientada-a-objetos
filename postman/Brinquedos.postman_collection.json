{
  "info": {
    "name": "AC4 - Brinquedos Esportivos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes de CRUD e de segurança (Basic Auth: admin/admin123 e user/user123)."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin",
        "type": "string"
      },
      {
        "key": "password",
        "value": "admin123",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. GET listar todos (admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/brinquedos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "brinquedos"
          ]
        }
      }
    },
    {
      "name": "2. GET por id (admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/brinquedos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "brinquedos",
            "1"
          ]
        }
      }
    },
    {
      "name": "3. GET filtrar por nome (admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/brinquedos?nome=bola",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "brinquedos"
          ],
          "query": [
            {
              "key": "nome",
              "value": "bola"
            }
          ]
        }
      }
    },
    {
      "name": "4. POST cadastrar - válido (admin) -> 201",
