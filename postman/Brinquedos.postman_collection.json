            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/brinquedos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "brinquedos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Skate Infantil\",\n  \"tipo\": \"Skate\",\n  \"classificacao\": 7,\n  \"tamanho\": \"M\",\n  \"preco\": 199.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
